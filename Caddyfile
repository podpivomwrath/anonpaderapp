# SITE_ADDRESS приходит из docker-compose.prod.yml (переменная DOMAIN из .env,
# по умолчанию — голый IP сервера). Пока DOMAIN пуст, Caddy обслуживает адрес
# как IP-литерал и НЕ пытается получить сертификат Let's Encrypt (ACME не
# выпускает сертификаты на IP) — просто отдаёт HTTP. Как только DOMAIN
# заполнится доменным именем, автоматический HTTPS включится сам, без правок
# этого файла.
{$SITE_ADDRESS} {
	encode gzip

	# API бота и вебхук VK — всегда на bot:8080, статику не отдаём под этими путями
	@backend path /api/* /vk/callback /health
	handle @backend {
		reverse_proxy bot:8080 {
			# Бот перезапускается при деплое ~10 секунд. Раньше Caddy в это
			# время сразу отвечал VK ошибкой («connection refused»), и VK
			# потом минутами слал события пачками с задержкой - игроки
			# ждали ответа по полминуты (2026-10-17). Теперь запрос ждёт,
			# пока бот поднимется, и уходит ему.
			lb_try_duration 20s
			lb_try_interval 250ms
		}
	}

	# Статика мини-аппа (собрана на этапе сборки этого образа, см. Dockerfile.caddy).
	# Если мини-апп хостится отдельно (напр. Vercel), этот блок просто не используется —
	# VK Mini App всё равно откроет внешний VITE_API_BASE_URL.
	handle {
		# Страница-оболочка не кэшируется: айфоны держали старую сборку и не
		# видели исправлений. Файлы сборки с хэшем в имени кэшируются как раньше.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		root * /srv/miniapp
		try_files {path} /index.html
		file_server
	}
}
